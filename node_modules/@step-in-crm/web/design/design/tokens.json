{
  "name": "Step-in-CRM",
  "company": "Step-in-Digitech",
  "version": "1.0.0",
  "description": "Design tokens for Step-in-CRM — Agentic CRM for Indian B2B",
  "color": {
    "roles": {
      "bg": { "value": "#f8fafc", "description": "Page background (slate-50)" },
      "surface": { "value": "#ffffff", "description": "Cards, modals, sheets (white)" },
      "surface-elevated": { "value": "#f1f5f9", "description": "Hover states, selected rows (slate-100)" },
      "border": { "value": "#e2e8f0", "description": "Default borders (slate-200)" },
      "border-input": { "value": "#cbd5e1", "description": "Input borders, focus rings base (slate-300)" },
      "border-focus": { "value": "#2563eb", "description": "Focus rings (blue-600)" },
      "text": { "value": "#0f172a", "description": "Primary text (slate-900)" },
      "text-muted": { "value": "#475569", "description": "Secondary text, placeholders (slate-600)" },
      "text-inverted": { "value": "#ffffff", "description": "Text on accent/dark (white)" },
      "accent": { "value": "#1e40af", "description": "Primary brand — deep blue (blue-800) — placeholder, replica-brand will replace" },
      "accent-hover": { "value": "#1e3a8a", "description": "Primary hover (blue-900)" },
      "accent-light": { "value": "#dbeafe", "description": "Primary light bg (blue-100)" },
      "accent-text": { "value": "#1e40af", "description": "Text on light primary (blue-800)" },
      "on-accent": { "value": "#ffffff", "description": "Text on primary (white)" },
      "danger": { "value": "#dc2626", "description": "Error, destructive (red-600)" },
      "danger-hover": { "value": "#b91c1c", "description": "Error hover (red-700)" },
      "danger-light": { "value": "#fef2f2", "description": "Error light bg (red-50)" },
      "danger-text": { "value": "#991b1b", "description": "Error text (red-900)" },
      "success": { "value": "#16a34a", "description": "Success, positive (green-600)" },
      "success-hover": { "value": "#15803d", "description": "Success hover (green-700)" },
      "success-light": { "value": "#f0fdf4", "description": "Success light bg (green-50)" },
      "success-text": { "value": "#14532d", "description": "Success text (green-900)" },
      "warning": { "value": "#ea580c", "description": "Warning, attention (orange-600)" },
      "warning-hover": { "value": "#c2410c", "description": "Warning hover (orange-700)" },
      "warning-light": { "value": "#fff7ed", "description": "Warning light bg (orange-50)" },
      "warning-text": { "value": "#7c2d12", "description": "Warning text (orange-900)" },
      "info": { "value": "#0891b2", "description": "Informational (cyan-600)" },
      "info-light": { "value": "#ecfeff", "description": "Info light bg (cyan-50)" },
      "info-text": { "value": "#164e63", "description": "Info text (cyan-900)" },
      "overlay": { "value": "rgba(15, 23, 42, 0.5)", "description": "Modal/backdrop overlay" },
      "shadow": { "value": "rgba(15, 23, 42, 0.08)", "description": "Box shadow color" },
      "shadow-strong": { "value": "rgba(15, 23, 42, 0.15)", "description": "Elevated shadow color" }
    },
    "pairs": [
      ["text", "bg"],
      ["text", "surface"],
      ["text-muted", "bg"],
      ["text-muted", "surface"],
      ["accent-text", "accent-light"],
      ["on-accent", "accent"],
      ["on-accent", "accent-hover"],
      ["danger-text", "danger-light"],
      ["danger", "surface"],
      ["success-text", "success-light"],
      ["success", "surface"],
      ["warning-text", "warning-light"],
      ["warning", "surface"],
      ["info-text", "info-light"],
      ["info", "surface"],
      ["text", "surface-elevated"],
      ["text-muted", "surface-elevated"]
    ]
  },
  "typography": {
    "fontFamilies": {
      "sans": "Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "mono": "JetBrains Mono, ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scale": {
      "xs": { "size": "12px", "lineHeight": "16px", "weight": "400", "letterSpacing": "0" },
      "sm": { "size": "13px", "lineHeight": "20px", "weight": "400", "letterSpacing": "0" },
      "base": { "size": "14px", "lineHeight": "20px", "weight": "400", "letterSpacing": "0" },
      "lg": { "size": "16px", "lineHeight": "24px", "weight": "400", "letterSpacing": "0" },
      "xl": { "size": "18px", "lineHeight": "28px", "weight": "500", "letterSpacing": "0" },
      "2xl": { "size": "20px", "lineHeight": "28px", "weight": "600", "letterSpacing": "0" },
      "3xl": { "size": "24px", "lineHeight": "32px", "weight": "600", "letterSpacing": "-0.01em" },
      "4xl": { "size": "30px", "lineHeight": "36px", "weight": "700", "letterSpacing": "-0.02em" },
      "5xl": { "size": "36px", "lineHeight": "44px", "weight": "700", "letterSpacing": "-0.02em" }
    },
    "weights": {
      "normal": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    }
  },
  "spacing": {
    "base": 4,
    "scale": {
      "0": "0",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px",
      "20": "80px",
      "24": "96px"
    }
  },
  "radius": {
    "none": "0",
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "2xl": "24px",
    "full": "9999px"
  },
  "shadows": {
    "none": "none",
    "xs": "0 1px 2px 0 var(--shadow)",
    "sm": "0 1px 3px 0 var(--shadow), 0 1px 2px -1px var(--shadow)",
    "md": "0 4px 6px -1px var(--shadow), 0 2px 4px -2px var(--shadow)",
    "lg": "0 10px 15px -3px var(--shadow), 0 4px 6px -4px var(--shadow)",
    "xl": "0 20px 25px -5px var(--shadow), 0 8px 10px -6px var(--shadow)",
    "2xl": "0 25px 50px -12px var(--shadow-strong)",
    "inner": "inset 0 2px 4px 0 var(--shadow)",
    "focus": "0 0 0 2px var(--surface), 0 0 0 4px var(--border-focus)"
  },
  "motion": {
    "durations": {
      "instant": "0ms",
      "fast": "150ms",
      "normal": "200ms",
      "slow": "300ms"
    },
    "easings": {
      "linear": "linear",
      "ease-in": "cubic-bezier(0.4, 0, 1, 1)",
      "ease-out": "cubic-bezier(0, 0, 0.2, 1)",
      "ease-in-out": "cubic-bezier(0.4, 0, 0.2, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  },
  "layout": {
    "maxWidth": "1280px",
    "headerHeight": "64px",
    "sidebarWidth": "280px",
    "sidebarCollapsedWidth": "72px",
    "breakpoints": {
      "sm": "640px",
      "md": "768px",
      "lg": "1024px",
      "xl": "1280px",
      "2xl": "1536px"
    },
    "grid": {
      "columns": 12,
      "gutter": "24px"
    }
  },
  "zIndex": {
    "base": 0,
    "dropdown": 100,
    "sticky": 200,
    "modal-backdrop": 300,
    "modal": 400,
    "popover": 500,
    "tooltip": 600,
    "toast": 700
  },
  "icons": {
    "set": "Lucide",
    "sizes": {
      "xs": "14px",
      "sm": "16px",
      "md": "18px",
      "lg": "20px",
      "xl": "24px"
    }
  },
  "breakpoints": {
    "mobile": "640px",
    "tablet": "768px",
    "desktop": "1024px",
    "wide": "1280px"
  }
}